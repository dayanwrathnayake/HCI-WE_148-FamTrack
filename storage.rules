rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid
        || (firestore.exists(/databases/(default)/documents/users/$(uid))
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(uid)).data.familyId != null
          && firestore.get(/databases/(default)/documents/users/$(uid)).data.familyId
             == firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId));
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
