# Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# .env.local is git-ignored. Restart Expo with `npx expo start -c` after editing it.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional local testing. Uses demo-famtrack, never the live project's database.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
# Web: 127.0.0.1; Android emulator: 10.0.2.2; phone: your computer's LAN IP.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
